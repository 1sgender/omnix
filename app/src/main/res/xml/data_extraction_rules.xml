<?xml version="1.0" encoding="utf-8"?>
<!--
    Исключаем чувствительные данные из бэкапа и переноса на новое устройство:
    зашифрованные настройки (ключи API) и локальную базу с историей диалогов.
    Атрибут domain обязателен, иначе правило игнорируется системой.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="omnix_secure_prefs.xml" />
        <exclude domain="database" path="omnix_database.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="omnix_secure_prefs.xml" />
        <exclude domain="database" path="omnix_database.db" />
    </device-transfer>
</data-extraction-rules>
