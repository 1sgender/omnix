<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window ground before the first Compose frame: the OMNIX warm graphite
      (OmnixColors WarmGraphite), so there is no flash of another colour
      between the launcher and the launch screen.
    -->
    <style name="Theme.OmniAssistant" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/omnix_launch_ground</item>
        <item name="android:statusBarColor">@color/omnix_launch_ground</item>
        <item name="android:navigationBarColor">@color/omnix_launch_ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
