<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ draws its own launch splash: the OMNIX mark on the warm
      graphite ground, the same ground the launch screen continues on.
    -->
    <style name="Theme.OmniAssistant" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/omnix_launch_ground</item>
        <item name="android:statusBarColor">@color/omnix_launch_ground</item>
        <item name="android:navigationBarColor">@color/omnix_launch_ground</item>
        <item name="android:windowLightStatusBar">@bool/omnix_light_bars</item>
        <item name="android:windowSplashScreenBackground">@color/omnix_launch_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="android:windowLightNavigationBar">@bool/omnix_light_bars</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/omnix_launch_ground</item>
    </style>
</resources>
