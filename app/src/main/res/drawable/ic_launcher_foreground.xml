<?xml version="1.0" encoding="utf-8"?>
<!--
  The supplied OMNIX cover art is the launcher foreground on Android 8+.
  The bitmap layer is stretched to the adaptive icon viewport; the artwork has
  its own safe dark margins, so launcher masks do not cut the Saturn mark.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/omnix_launcher_art"
    android:gravity="fill"
    android:filter="true" />
