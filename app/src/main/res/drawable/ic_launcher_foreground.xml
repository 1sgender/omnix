<?xml version="1.0" encoding="utf-8"?>
<!--
  OMNIX mark ("stencil O"): a ring cut by a horizontal slit, the top half
  shifted left, the bottom half shifted right. Same geometry as OmnixRingMark.
  Scaled to 0.9 so every launcher mask keeps the whole mark inside the safe zone.
  Colour follows the system theme: black on white, white on black.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.9"
        android:scaleY="0.9">
        <path
            android:pathData="M31.73,51A19.5,19.5 0,1 1,70.27 51"
            android:strokeColor="@color/omnix_icon_mark"
            android:strokeWidth="13" />
        <path
            android:pathData="M76.27,57A19.5,19.5 0,1 1,37.73 57"
            android:strokeColor="@color/omnix_icon_mark"
            android:strokeWidth="13" />
    </group>
</vector>
